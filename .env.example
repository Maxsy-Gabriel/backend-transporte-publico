# -----------------------------------------------------------------------------
# Variáveis de ambiente do Transporte Escolar API.
#
# Uso: copie este arquivo para .env e ajuste os valores
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env
#
# O .env NUNCA é versionado (está no .gitignore). Em produção as variáveis vêm do
# ambiente da plataforma. Este arquivo só tem valores de exemplo, nenhum segredo real.
# -----------------------------------------------------------------------------

# Ambiente: development | test | production
NODE_ENV=development
# Porta HTTP da API
PORT=3000

# PostgreSQL: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# A aplicação e o Prisma CLI (migrate) usam esta mesma variável.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/transporte_escolar

# Segredos: gere valores aleatórios e DIFERENTES em cada ambiente (dev, test, produção):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo de 32 caracteres cada. Em produção, os valores de exemplo abaixo são recusados.

# JWT: assinatura do token de login. Duração: 15m, 1h, 7d...
JWT_SECRET=dev-change-me-dev-change-me-dev-change-me-dev
JWT_EXPIRES_IN=1h

# API key: TODA rota exige o cabeçalho X-API-KEY com este valor (identifica a aplicação
# cliente). Entregue a chave só às aplicações autorizadas.
API_KEY=dev-change-me-api-key-dev-change-me-api-key

# Seed: administrador inicial criado por `npm run db:seed` (senha com pelo menos 12 caracteres).
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=dev-change-me-admin-password
